<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>capslock+icon.ico</ApplicationIcon>
    <!-- 输出文件名取自 AssemblyName；版本与产品名写入文件属性。 -->
    <AssemblyName>capslock-enhanced</AssemblyName>
    <Version>1.1.0</Version>
    <Product>capslock-enhanced</Product>
    <AssemblyTitle>capslock-enhanced</AssemblyTitle>
    <Company>capslock-enhanced</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <None Update="install-autostart.ps1" CopyToPublishDirectory="Always" />
    <None Update="ensure-autostart.ps1" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
